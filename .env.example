# JWT Configuration
JWT_ALGORITHM=HS256
JWT_SECRET_TOKEN=your_jwt_secret_key_here

# App Configuration
APP_NAME=Messenger
APP_HOST=0.0.0.0
APP_PORT=8000
APP_RELOAD=1

# Environment
ENVIRONMENT=development

# Database Configuration
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_USER=your_database_user
POSTGRES_PASSWORD=your_database_password
POSTGRES_DB=messenger

# Database URL (auto-generated from above variables)
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_SERVER}:${POSTGRES_PORT}/${POSTGRES_DB}

# Redis Cache Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# SMTP Configuration (for email services)
SMTP_SERVER=mailpit
SMTP_PORT=1025
SMTP_PASSWORD=
SMTP_USERNAME=

# Default admin bootstrap
ADMIN_EMAIL=admin@messenger.local
ADMIN_PASSWORD=Admin12345!
ADMIN_USERNAME=@admin

# Default test user bootstrap
TEST_USER_EMAIL=test@messenger.local
TEST_USER_PASSWORD=Test12345!
TEST_USER_USERNAME=@testuser
